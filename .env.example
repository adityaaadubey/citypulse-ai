# CityPulse AI Environment Configuration
# Copy this to .env.local for local development or set in Vercel Project Settings

# Supabase (Optional for cloud report sync, works locally if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini (Server-only AI Assistant)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

