# CityPulse AI Environment Configuration
# Copy this to .env.local for local development or set in Vercel Project Settings

# Supabase (Optional for cloud report sync, works locally if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (Optional for AI Assistant, works with rule-based fallback if omitted)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
